# 复制为 .env，在本机填写；禁止上传实际 .env 或分享真实密钥。
# 正式启动使用 --env-file .env，确保在导入认证模块前加载配置。

# AI 作答：留空则仅检索；默认提供方为 DeepSeek。
DEEPSEEK_API_KEY=

# 云端 OCR：会上传 PDF 到 MinerU，按需填写。
MINERU_TOKEN=

# embedding/rerank 默认 native，本机模型路径为 kb/models/。
# 选择公网提供方时，检索文本会离开本机；按需分别设置。
# KB_EMBED_PROVIDER=siliconflow
# KB_RERANK_PROVIDER=siliconflow
# SILICONFLOW_API_KEY=

# 内网/本地 API（OpenAI 兼容接口），按需启用。
# KB_PROVIDER=local
# KB_LOCAL_BASE_URL=http://127.0.0.1:8080/v1
# KB_LOCAL_MODEL=
# KB_LOCAL_API_KEY=

# 正式启动必须填访问口令；签名密钥应使用随机值并保密。
KB_PASSCODE=
KB_SECRET=
# HTTPS 服务填 1；本机 HTTP 测试保持空值，不能填 0。
KB_HTTPS=
