{"chunk_id": "DEP-T-AR2107-2019#正文#5.6", "std_code": "DEP-T-AR2107-2019", "std_name": "倒班宿舍建筑设计导则", "version": "2019", "clause_no": "5.6", "chapter_path": "5 建筑设计", "section_type": "正文", "text": "每栋宿舍应设置管理室、晾晒空间，宿舍内应设置盥洗室和厕所。", "tables": [], "page_idx": 4, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2107-2019#正文#5.7", "std_code": "DEP-T-AR2107-2019", "std_name": "倒班宿舍建筑设计导则", "version": "2019", "clause_no": "5.7", "chapter_path": "5 建筑设计", "section_type": "正文", "text": "宿舍的居室宜集中布置，半数以上居室应有良好朝向，并应具有住宅居室相同的日照标准。", "tables": [], "page_idx": 4, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2107-2019#正文#5.8", "std_code": "DEP-T-AR2107-2019", "std_name": "倒班宿舍建筑设计导则", "version": "2019", "clause_no": "5.8", "chapter_path": "5 建筑设计", "section_type": "正文", "text": "每栋宿舍宜根据项目实际需要设置员工活动室、阅览室等公共活动空间。", "tables": [], "page_idx": 4, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2107-2019#正文#5.9", "std_code": "DEP-T-AR2107-2019", "std_name": "倒班宿舍建筑设计导则", "version": "2019", "clause_no": "5.9", "chapter_path": "5 建筑设计", "section_type": "正文", "text": "倒班宿舍设有男女员工宿舍时，男女居室宜分楼层或分区设置。", "tables": [], "page_idx": 4, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
