{"chunk_id": "DEP-T-AR2107-2019#正文#5.11", "std_code": "DEP-T-AR2107-2019", "std_name": "倒班宿舍建筑设计导则", "version": "2019", "clause_no": "5.11", "chapter_path": "5 建筑设计", "section_type": "正文", "text": "每个居室类型可以按入住人数分单人间、双人间、三人间和四人间。居室内可根据项目实际需要配置卫生间。", "tables": [], "page_idx": 4, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
