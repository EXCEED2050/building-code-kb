{"chunk_id": "DEP-T-AR2107-2019#正文#7.5", "std_code": "DEP-T-AR2107-2019", "std_name": "倒班宿舍建筑设计导则", "version": "2019", "clause_no": "7.5", "chapter_path": "7 室内环境", "section_type": "正文", "text": "宿舍居室内的允许噪声级（A声级），昼间应小于或等于45dB，夜间应小于或等于37dB。", "tables": [], "page_idx": 9, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2107-2019#正文#7.6", "std_code": "DEP-T-AR2107-2019", "std_name": "倒班宿舍建筑设计导则", "version": "2019", "clause_no": "7.6", "chapter_path": "7 室内环境", "section_type": "正文", "text": "居室不应与设备机房、电梯紧邻布置，与公共楼梯间、公共盥洗室、公共活动室等有噪音的房间紧邻布置时，应采取隔声减噪措施，其隔声性能评价量应符合《宿舍建筑设计规范》相关规定。", "tables": [], "page_idx": 9, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
