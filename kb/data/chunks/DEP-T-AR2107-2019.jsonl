{"chunk_id": "DEP-T-AR2107-2019#正文#5.4", "std_code": "DEP-T-AR2107-2019", "std_name": "倒班宿舍建筑设计导则", "version": "2019", "clause_no": "5.4", "chapter_path": "5 建筑设计", "section_type": "正文", "text": "单边内走道单边布置宿舍；", "tables": [], "page_idx": 4, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
