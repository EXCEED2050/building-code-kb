{"chunk_id": "DEP-T-AR2108-2019#正文#4.10", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "4.10", "chapter_path": "4 食堂分类及面积指标", "section_type": "正文", "text": "备餐使用面积：0.70m2/座。", "tables": [], "page_idx": 4, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#5.1", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "5.1", "chapter_path": "5 建筑功能空间组成", "section_type": "正文", "text": "大、中型自烹型食堂组成：\n食堂管理食堂管理大餐厅大餐厅卫生间卫生间洗衣烘干洗衣烘干更衣更衣主食库主食库主食粗加工主食粗加工洗手洗手\n副食热加工副食热加工主食热加工主食热加工点心制作点心制作餐布洗涤烘干餐布洗涤烘干备餐备餐杂物间杂物间门厅门厅\n熟食库熟食库\n卫生间卫生间\n餐具消毒存放餐具消毒存放餐具洗涤餐具洗涤副食粗细加工副食粗细加工副食库副食库", "tables": [], "page_idx": 4, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#5.2", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "5.2", "chapter_path": "5 建筑功能空间组成", "section_type": "正文", "text": "小型自烹型食堂组成：\n餐具洗涤消毒餐具洗涤消毒副食库副食库主食库主食库餐厅餐厅\n热加工热加工\n食堂管理管理食堂管理管理卫生间卫生间洗衣烘干洗衣烘干更衣更衣", "tables": [], "page_idx": 4, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#5.3", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "5.3", "chapter_path": "5 建筑功能空间组成", "section_type": "正文", "text": "配送型食堂组成：\n餐厅餐厅杂物间杂物间餐具洗涤消毒餐具洗涤消毒\n少量热加工 备餐少量热加工 备餐\n食堂管理食堂管理更衣更衣洗衣烘干干洗衣烘干干卫生间卫生间", "tables": [], "page_idx": 4, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.1", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.1", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "一般规定", "tables": [], "page_idx": 4, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.2", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.2", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "食堂建筑设计应符合JGJ 64的要求。", "tables": [], "page_idx": 5, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.3", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.3", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "食堂宜采用钢筋混凝土框架结构，耐火等级不应低于二级。当与其他建筑合建时食堂宜位于建筑的底层，多层食堂宜设电梯。", "tables": [], "page_idx": 5, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.4", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.4", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "食堂建筑防火设计应符合GB 50016的相关规定。", "tables": [], "page_idx": 5, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.5", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.5", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "食堂建筑室内空气质量应符合GB/T 18883的规定。", "tables": [], "page_idx": 5, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.6", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.6", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "食堂建筑室内声环境设计应符合GB 50118的规定。", "tables": [], "page_idx": 5, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.7", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.7", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "食堂建筑节能设计应符合GB 50189的规定。", "tables": [], "page_idx": 5, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.8", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.8", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "食堂建筑无障碍设计应符合GB 50763的规定。", "tables": [], "page_idx": 5, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.9", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.9", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "食堂除厨房热加工区域外，土建与装修宜进行一体化设计。", "tables": [], "page_idx": 5, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.10", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.10", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "食堂应采取防鼠、防蝇和防其他有害动物、昆虫及防尘、防潮、防异味、通风等有效措施。", "tables": [], "page_idx": 6, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.11", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.11", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "餐厅区域设计", "tables": [], "page_idx": 6, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.12", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.12", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "餐厅应自然采光，窗外宜有良好自然景观。侧面采光窗洞口面积不宜小于该厅地面面积的1/6.自然通风时，通风开口面积不应小于该厅地面面积的1/20。餐厅宜采用低窗台。", "tables": [], "page_idx": 6, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.13", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.13", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "餐厅净高不宜低于3.00m，小型餐厅不宜低于2.80m，大型餐厅不宜低于3.5m。售饭窗口区宜考虑排队空间。", "tables": [], "page_idx": 6, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.14", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.14", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "餐厅入口处宜设置洗手台，宜采用感应恒温热水龙头，龙头按每50人1个配置，并不宜少于2个。", "tables": [], "page_idx": 6, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.15", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.15", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "餐厅设置卫生间时，卫生间的门不应直接开向餐厅。", "tables": [], "page_idx": 6, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.16", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.16", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "餐厅的室内各部分面层应选用不易积垢、易清洁的材料，墙及天棚阴角宜做成弧形。", "tables": [], "page_idx": 6, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.17", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.17", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "售饭窗台应采用光滑、不渗水和易清洁的材料。", "tables": [], "page_idx": 6, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.18", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.18", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "餐桌间距、餐桌和墙面的间距要求参见JGJ 64。", "tables": [], "page_idx": 6, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.19", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.19", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "厨房区域设计", "tables": [], "page_idx": 6, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.20", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.20", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "厨房应按原料进入、原料处理、主食加工、副食加工、备餐、成品供应、餐用具洗涤消毒及存放的工艺流程合理布局，严格做到原料与成品分开，生食与熟食分开加工和存放，食品加工处理流程宜为生进熟出单一流向。", "tables": [], "page_idx": 6, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.21", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.21", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "大、中型食堂的厨房平面布置应有厨房设备公司二次设计，建筑设计应与专业厨房设备公司密切配合，合理设置排水明沟的位置。", "tables": [], "page_idx": 6, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.22", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.22", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "厨房有明火的加工区应采用耐火极限不低于2.00h的防火隔墙与其他部位分隔，隔墙上的门、窗应采用乙级防火门、窗。厨房的热加工区应预留竖向排气道。", "tables": [], "page_idx": 6, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.23", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.23", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "厨房的净高不宜低于3.00m。大型厨房不宜低于4.00m。", "tables": [], "page_idx": 6, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.24", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.24", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "厨房区域热加工间的上层有餐厅或其他用房时，其外墙开口上方应设置宽度不小于1.0m、长度不小于开口宽度的防火挑檐；或在建筑外墙上、下层开口之间设置高度不小于1.2m的实体墙。实体墙和防火挑檐的耐火极限和燃烧性能均不应低于相应建筑外墙的要求。", "tables": [], "page_idx": 6, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.25", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.25", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "厨房区域各加工场所的室内构造应符合下列规定：", "tables": [], "page_idx": 6, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.26", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.26", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "地面应采用无毒、无异味、不易积垢、防滑易清洗、耐磨损的材料；", "tables": [], "page_idx": 6, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.27", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.27", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "地面应处理好防水、排水，排水沟内阴角应采用弧形；", "tables": [], "page_idx": 6, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.28", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.28", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "地面不宜设置台阶；", "tables": [], "page_idx": 6, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.29", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.29", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "墙面、隔断及工作台、水池等设施均应采用无毒、无异味、不透水、易清洁的材料，阴角宜做成曲率半径不小于3cm的弧形；", "tables": [], "page_idx": 6, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.30", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.30", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "备餐区等清洁操作区内不得设置排水明沟，地漏应能防止废弃物流入及浊气溢出；", "tables": [], "page_idx": 7, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.31", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.31", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "天花板应选用无毒、无异味、不吸水、表面光洁、耐腐蚀、耐湿的装修，水蒸气较多的房间的天花板宜有适当坡度，减少凝结水滴落；", "tables": [], "page_idx": 7, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.32", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.32", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "粗加工区、细加工区、餐用具洗消间等需经常冲洗的易潮湿场所应有1.5米以上光滑、不吸水、耐用和易清洗材料的墙裙。", "tables": [], "page_idx": 7, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.33", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.33", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "辅助区域设计", "tables": [], "page_idx": 7, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.34", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.34", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "职工食堂的辅助部分一般由主食库、副食库、管理用房、工作人员更衣间、淋浴间、卫生间、垃圾和清扫工具存放间等用房组成。", "tables": [], "page_idx": 7, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.35", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.35", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "库房宜根据食材和食品的分类分别设置，并根据需要设置冷藏及冷冻设施。", "tables": [], "page_idx": 7, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.36", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.36", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "工作人员更衣间宜按全部工作人员男女分设，每人一格更衣柜。更衣间入口处应设置采用非手动式开关的洗手、干手消毒设施。", "tables": [], "page_idx": 7, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.37", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.37", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "工作人员的卫生间应男女分设，卫生间应设在食品处理区以外。应采用非手动式开关的洗手、干手消毒设施。", "tables": [], "page_idx": 7, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.38", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.38", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "清洁间和垃圾间应选择相对隐蔽的部位设置，且不应影响食品安全。垃圾间的位置应考虑方便垃圾及时外运。清洁间和垃圾间室内装修用材和构造做法应该方便清洁、避免异味外溢。", "tables": [], "page_idx": 7, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#6.39", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "6.39", "chapter_path": "6 建筑设计", "section_type": "正文", "text": "食堂管理用房宜设置在辅助区域人员入口附近。管理用房宜有天然采光和自然通风条件。", "tables": [], "page_idx": 7, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#7.1", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "7.1", "chapter_path": "7 常用室内装修材料及构造", "section_type": "正文", "text": "室内装修材料应符合现行国家标准GB 50325的规定。", "tables": [], "page_idx": 7, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#7.2", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "7.2", "chapter_path": "7 常用室内装修材料及构造", "section_type": "正文", "text": "室内装修材料的燃烧性能应符合GB 50222的相关规定。", "tables": [], "page_idx": 7, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#7.3", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "7.3", "chapter_path": "7 常用室内装修材料及构造", "section_type": "正文", "text": "餐厅常用装修材料", "tables": [], "page_idx": 7, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#7.4", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "7.4", "chapter_path": "7 常用室内装修材料及构造", "section_type": "正文", "text": "地面宜采用防滑地砖或防滑PVC卷材。", "tables": [], "page_idx": 7, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#7.5", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "7.5", "chapter_path": "7 常用室内装修材料及构造", "section_type": "正文", "text": "墙面宜采用涂料，必要时可采用瓷砖墙裙。", "tables": [], "page_idx": 7, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#7.6", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "7.6", "chapter_path": "7 常用室内装修材料及构造", "section_type": "正文", "text": "吊顶宜采用矿棉吸声板、镂空金属板或金属格栅、轻钢龙骨石膏板。", "tables": [], "page_idx": 7, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#7.7", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "7.7", "chapter_path": "7 常用室内装修材料及构造", "section_type": "正文", "text": "窗台宜采用花岗石、人造石、不锈钢。", "tables": [], "page_idx": 7, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#7.8", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "7.8", "chapter_path": "7 常用室内装修材料及构造", "section_type": "正文", "text": "厨房常用装修材料", "tables": [], "page_idx": 7, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#7.9", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "7.9", "chapter_path": "7 常用室内装修材料及构造", "section_type": "正文", "text": "地面宜采用防滑地砖", "tables": [], "page_idx": 7, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#7.10", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "7.10", "chapter_path": "7 常用室内装修材料及构造", "section_type": "正文", "text": "墙面宜采用瓷砖墙裙，高度不小于1.5米或至顶。", "tables": [], "page_idx": 8, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#7.11", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "7.11", "chapter_path": "7 常用室内装修材料及构造", "section_type": "正文", "text": "顶棚宜采用防霉涂料(A级)，需设置吊顶时宜采用金属板材吊顶。", "tables": [], "page_idx": 8, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
{"chunk_id": "DEP-T-AR2108-2019#正文#7.12", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "7.12", "chapter_path": "7 常用室内装修材料及构造", "section_type": "正文", "text": "窗台宜采用花岗石、人造石、不锈钢。", "tables": [], "page_idx": 8, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
