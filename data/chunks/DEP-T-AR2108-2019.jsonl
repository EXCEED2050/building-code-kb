{"chunk_id": "DEP-T-AR2108-2019#正文#4.6", "std_code": "DEP-T-AR2108-2019", "std_name": "职工食堂建筑设计导则", "version": "2019", "clause_no": "4.6", "chapter_path": "4 食堂分类及面积指标", "section_type": "正文", "text": "餐厅使用面积：2.00m2/座；", "tables": [], "page_idx": 4, "is_mandatory": false, "mandatory_basis": "", "superseded": false, "status": "待核", "caveat": ""}
